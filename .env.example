# Better Auth Secret (Generate using: openssl rand -base64 32)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Deployed URL in production (e.g., https://your-bazar-dor.vercel.app)
# For local dev: http://localhost:3000
BETTER_AUTH_URL=https://your-domain.vercel.app

# Optional client auth url
NEXT_PUBLIC_BETTER_AUTH_URL=https://your-domain.vercel.app

# MongoDB Connection String with full replica set & credentials
# IMPORTANT: In MongoDB Atlas -> Network Access -> IP Access List:
# Add 0.0.0.0/0 to allow connections from Vercel / serverless deployments!
BETTER_AUTH_DB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bazardor?retryWrites=true&w=majority
